# Generated local build output is recreated by Vercel and must not be uploaded.
.next
.next/**

# Local development dependencies and caches are installed or generated remotely.
node_modules
node_modules/**
.git
.git/**
coverage
tmp
*.log

# Local tooling, generated reports, and the archived release checkout are not
# application source. Keeping them out of deployments makes builds reproducible
# and prevents their test suite from being type-checked as part of the site.
_npx
_npx/**
_cacache
_cacache/**
_logs
_logs/**
artifacts
artifacts/**
reports
reports/**
scratch
scratch/**
release-checkout
release-checkout/**
