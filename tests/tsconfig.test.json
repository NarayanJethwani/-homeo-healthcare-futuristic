{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./tests/stubs/server-only"]
    }
  },
  "include": [
    "**/*.ts",
    "../src/**/*.ts"
  ]
}
