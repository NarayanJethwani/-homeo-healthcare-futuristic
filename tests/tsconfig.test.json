{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "baseUrl": ".",
    "paths": {
      "@/features/knowledge/content/*": ["../src/features/knowledge/content/*/index.ts", "../src/features/knowledge/content/*"],
      "@/*": ["../src/*", "../src/*/index.ts"],
      "server-only": ["./stubs/server-only"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
