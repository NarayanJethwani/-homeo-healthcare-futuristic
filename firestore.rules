rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }
    function isEditor() {
      return request.auth != null && getUserData().role == 'editor';
    }
    function isClinicalReviewer() {
      return request.auth != null && getUserData().role == 'clinical-reviewer';
    }
    function isRepertoryReviewer() {
      return isAdmin() || isEditor() || isClinicalReviewer();
    }

    function validAnnotation(data) {
      let allowedKeys = ['id', 'practitionerId', 'bookId', 'sourceVersionId', 'passageId', 'blockId', 'annotationType', 'selectedText', 'noteText', 'anchor', 'anchorState', 'createdAt', 'updatedAt', 'revision'];
      return data.keys().hasAll(['id', 'practitionerId', 'bookId', 'sourceVersionId', 'passageId', 'blockId', 'annotationType', 'anchor', 'anchorState', 'createdAt', 'updatedAt', 'revision'])
        && data.keys().hasOnly(allowedKeys)
        && data.annotationType in ['keynote', 'mental', 'general', 'modality', 'causation', 'clinical', 'differential', 'personal']
        && (!data.keys().hasAny(['noteText']) || (data.noteText is string && data.noteText.size() <= 2000))
        && (!data.keys().hasAny(['selectedText']) || data.selectedText is string)
        && data.anchor.keys().hasAll(['startOffset', 'endOffset', 'textChecksum'])
        && data.anchor.startOffset >= 0
        && data.anchor.endOffset >= data.anchor.startOffset
        && data.anchor.textChecksum is string
        && data.anchorState in ['valid', 'source-version-changed', 'text-mismatch', 'orphaned']
        && data.createdAt is string
        && data.updatedAt is string
        && data.revision is int
        && data.revision >= 0;
    }

    function validBookmark(data) {
      let allowedKeys = ['id', 'practitionerId', 'bookId', 'sourceVersionId', 'passageId', 'blockId', 'createdAt'];
      return data.keys().hasAll(['id', 'practitionerId', 'bookId', 'sourceVersionId', 'passageId', 'createdAt'])
        && data.keys().hasOnly(allowedKeys)
        && data.createdAt is string;
    }

    function validReaderPosition(data) {
      let allowedKeys = ['practitionerId', 'bookId', 'sourceVersionId', 'passageId', 'blockId', 'relativeOffset', 'updatedAt'];
      return data.keys().hasAll(['practitionerId', 'bookId', 'sourceVersionId', 'passageId', 'updatedAt'])
        && data.keys().hasOnly(allowedKeys)
        && (!data.keys().hasAny(['relativeOffset']) || data.relativeOffset is number)
        && data.updatedAt is string;
    }

    // ─── User Profiles ───────────────────────────────────────────────────────
    // Admins can read/write all user profiles (needed for doctor onboarding).
    // A user can always read and update their own profile.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // ─── Patient Records ─────────────────────────────────────────────────────
    // TRUE SERVER-SIDE ISOLATION:
    //   • Admin sees ALL patients.
    //   • A doctor sees ONLY the patients assigned to them (assignedDoctor == uid).
    //   • No client-side filtering required — Firestore rejects unauthorised reads at DB level.
    match /patients/{patientId} {
      allow read: if request.auth != null && (
        resource.data.assignedDoctor == request.auth.uid ||
        isAdmin()
      );

      // Only admin or the patient's own assigned doctor may update/delete.
      allow update, delete: if request.auth != null && (
        resource.data.assignedDoctor == request.auth.uid ||
        isAdmin()
      );

      // Any authenticated user (intake API server-side call) may create a new patient record.
      allow create: if request.auth != null;
    }

    // ─── Doctors Directory ───────────────────────────────────────────────────
    // Stores per-doctor workspace metadata (driveFolderId, masterSheetId, subscription).
    // Only the super admin can write these records; doctors can read their own.
    match /doctors/{doctorId} {
      allow read: if request.auth != null && (
        request.auth.uid == doctorId || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ─── Repertory / Knowledge Collections ──────────────────────────────────
    match /rubrics/{rubricId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /synonyms/{synonymId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /favorites/{favoriteId} {
      allow read, write: if request.auth != null && (
        favoriteId == request.auth.uid ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    match /repertorization_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read, write: if request.auth != null;
    }

    match /ai_telemetry_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && conversationId == request.auth.uid;
    }

    // ─── CMS Drafts / Versions ───────────────────────────────────────────────
    // Client web SDKs cannot write directly to CMS drafts or versions.
    // They are only readable by authenticated users.
    match /cms_drafts/{draftId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /cms_versions/{versionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /clinical_graph_nodes/{nodeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /clinical_graph_edges/{edgeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /clinical_graph_edge_versions/{versionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /clinical_graph_audit_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Repertory Operations, Reviews, Pointers, and Audits ─────────────────
    match /repertoryAcquisitionRecords/{recordId} {
      allow read: if isRepertoryReviewer();
      allow write: if false;
    }
    match /repertorySourceReviews/{reviewId} {
      allow read: if isRepertoryReviewer();
      allow write: if false;
    }
    match /repertoryActiveCorpusPointer/{pointerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /repertoryEditorialAuditLogs/{logId} {
      allow read: if isAdmin() || isClinicalReviewer();
      allow write: if false;
    }

    // ─── Practitioner Materia Medica Workspace ─────────────────────────────
    match /practitioners/{practitionerId}/materiaMedicaAnnotations/{annotationId} {
      allow get, list: if request.auth != null
        && request.auth.uid == practitionerId;

      allow create: if request.auth != null
        && request.auth.uid == practitionerId
        && request.resource.data.practitionerId == practitionerId
        && validAnnotation(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == practitionerId
        && resource.data.practitionerId == practitionerId
        && request.resource.data.practitionerId == practitionerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.sourceVersionId == resource.data.sourceVersionId
        && request.resource.data.passageId == resource.data.passageId
        && request.resource.data.blockId == resource.data.blockId
        && request.resource.data.anchor == resource.data.anchor
        && request.resource.data.revision == resource.data.revision + 1
        && validAnnotation(request.resource.data);

      allow delete: if request.auth != null
        && request.auth.uid == practitionerId
        && resource.data.practitionerId == practitionerId;
    }

    match /practitioners/{practitionerId}/materiaMedicaBookmarks/{bookmarkId} {
      allow get, list: if request.auth != null
        && request.auth.uid == practitionerId;

      allow create: if request.auth != null
        && request.auth.uid == practitionerId
        && request.resource.data.practitionerId == practitionerId
        && validBookmark(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == practitionerId
        && resource.data.practitionerId == practitionerId
        && request.resource.data.practitionerId == practitionerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.sourceVersionId == resource.data.sourceVersionId
        && request.resource.data.passageId == resource.data.passageId
        && request.resource.data.blockId == resource.data.blockId
        && validBookmark(request.resource.data);

      allow delete: if request.auth != null
        && request.auth.uid == practitionerId
        && resource.data.practitionerId == practitionerId;
    }

    match /practitioners/{practitionerId}/materiaMedicaReaderPositions/{positionId} {
      allow get: if request.auth != null
        && request.auth.uid == practitionerId;

      allow create: if request.auth != null
        && request.auth.uid == practitionerId
        && request.resource.data.practitionerId == practitionerId
        && validReaderPosition(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == practitionerId
        && resource.data.practitionerId == practitionerId
        && request.resource.data.practitionerId == practitionerId
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.sourceVersionId == resource.data.sourceVersionId
        && validReaderPosition(request.resource.data);

      allow delete: if request.auth != null
        && request.auth.uid == practitionerId
        && resource.data.practitionerId == practitionerId;
    }

    // ─── Knowledge Governance Collections ─────────────────────────────────
    // Direct Client Web/Mobile SDK access denied (Fail-Closed).
    // Access permitted ONLY through authenticated Firebase Admin SDK server context.
    match /knowledgeGovernanceContributors/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceQualifications/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceAuthorship/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceRevisions/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceReviews/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceEvidenceProfiles/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceClaims/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceAiApprovals/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceEntityState/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceAuditChainHeads/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceOnboardingRecords/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceOnboardingIdentityLocks/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceOnboardingAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1Assignments/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1SourceAcquisition/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1AcquisitionAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1AcquisitionJobs/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1SourceArtifacts/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1ArtifactVerifications/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1AcquisitionJobAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1DraftHeads/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1DraftRevisions/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1DraftAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1IndependentReviews/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1ReviewAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1OfflineEvaluations/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1EvaluationAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1GoNoGoDecisions/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep1DecisionAuditEvents/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep3CohortProposals/{docId} { allow read, write: if false; }
    match /knowledgeGovernanceKep3CohortPlanningAuditEvents/{docId} { allow read, write: if false; }
  }
}
