rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile access rules
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Patient records access rules
    match /patients/{patientId} {
      // Allow read for all authenticated users (admin + doctors).
      // Client-side filtering in the dashboard restricts which patients each doctor *sees*,
      // but the Firestore query must be allowed to scan the whole collection first.
      allow read: if request.auth != null;

      // Allow write (update/delete) only to admins or the patient's assigned doctor
      allow write: if request.auth != null && (
        getUserData().role == 'admin' ||
        resource.data.assignedDoctor == request.auth.uid ||
        request.resource.data.assignedDoctor == request.auth.uid
      );

      // Allow creation of new patient records by any authenticated user (intake API)
      allow create: if request.auth != null;
    }

    // Helper function to query the user's role and data from their profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Repertory collections rules
    match /rubrics/{rubricId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /synonyms/{synonymId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /favorites/{favoriteId} {
      allow read, write: if request.auth != null && (
        favoriteId == request.auth.uid || 
        (resource != null && resource.data.userId == request.auth.uid) || 
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    match /repertorization_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read, write: if request.auth != null;
    }

    match /ai_telemetry_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && conversationId == request.auth.uid;
    }
  }
}
