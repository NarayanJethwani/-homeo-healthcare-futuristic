rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }

    // ─── User Profiles ───────────────────────────────────────────────────────
    // Admins can read/write all user profiles (needed for doctor onboarding).
    // A user can always read and update their own profile.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // ─── Patient Records ─────────────────────────────────────────────────────
    // TRUE SERVER-SIDE ISOLATION:
    //   • Admin sees ALL patients.
    //   • A doctor sees ONLY the patients assigned to them (assignedDoctor == uid).
    //   • No client-side filtering required — Firestore rejects unauthorised reads at DB level.
    match /patients/{patientId} {
      allow read: if request.auth != null && (
        resource.data.assignedDoctor == request.auth.uid ||
        isAdmin()
      );

      // Only admin or the patient's own assigned doctor may update/delete.
      allow update, delete: if request.auth != null && (
        resource.data.assignedDoctor == request.auth.uid ||
        isAdmin()
      );

      // Any authenticated user (intake API server-side call) may create a new patient record.
      allow create: if request.auth != null;
    }

    // ─── Doctors Directory ───────────────────────────────────────────────────
    // Stores per-doctor workspace metadata (driveFolderId, masterSheetId, subscription).
    // Only the super admin can write these records; doctors can read their own.
    match /doctors/{doctorId} {
      allow read: if request.auth != null && (
        request.auth.uid == doctorId || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ─── Repertory / Knowledge Collections ──────────────────────────────────
    match /rubrics/{rubricId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /synonyms/{synonymId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /favorites/{favoriteId} {
      allow read, write: if request.auth != null && (
        favoriteId == request.auth.uid ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    match /repertorization_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read, write: if request.auth != null;
    }

    match /ai_telemetry_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && conversationId == request.auth.uid;
    }
  }
}
