# Google Cloud Service Account Credentials (JSON string)
# Keep single quotes around the JSON value to prevent issues with multiline private keys
GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "YOUR_PROJECT_ID", "private_key": "-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n", "client_email": "YOUR_CLIENT_EMAIL"}'

# Google Workspace / Drive Integration coordinates
GOOGLE_DRIVE_PARENT_FOLDER_ID="YOUR_GOOGLE_DRIVE_PARENT_FOLDER_ID"
GOOGLE_TEMPLATE_SHEET_ID="YOUR_GOOGLE_TEMPLATE_CLINICAL_RECORD_SHEET_ID"

# Google Calendar Integration
GOOGLE_CALENDAR_ID="primary"

# Firebase Admin SDK Configuration (Optional: fallback keys)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "YOUR_PROJECT_ID", "private_key": "-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n", "client_email": "YOUR_CLIENT_EMAIL"}'

# Admin route session signing
# Required in production (NODE_ENV=production). Must be a dedicated long random secret.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Firebase Client SDK Configuration (Required for client-side authentication and queries)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"

# Governed repertory artifacts remain disabled until a reviewed corpus is
# uploaded under this private server-side bucket and prefix.
REPERTORY_ARTIFACT_STORE="local-readonly"
REPERTORY_ARTIFACT_BUCKET="YOUR_PRIVATE_REPERTORY_BUCKET"
REPERTORY_ARTIFACT_PREFIX="repertory"

# Doctor repertory pilot (server-only, fail-closed). Both values are required.
# Keep disabled until a practitioner account has active search/repertorize capabilities.
REPERTORY_DOCTOR_PILOT_ENABLED="false"
REPERTORY_DOCTOR_PILOT_UIDS=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Gemini AI Credentials
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Backend Configurations (Private environment variables)
DOCTOR_EMAILS="doctor1@example.com,doctor2@example.com"
WHATSAPP_NUMBER="918446056789"
WHATSAPP_DISPLAY="+91 84460 56789"
PAYMENT_UPI="8446056789@hdfc"
PAYMENT_PHONE="8446056789"

# Frontend Configurations (Public environment variables for Direct Links & Displays)
NEXT_PUBLIC_WHATSAPP_NUMBER="918446056789"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+91 84460 56789"
NEXT_PUBLIC_PAYMENT_UPI="8446056789@hdfc"
NEXT_PUBLIC_PAYMENT_PHONE="8446056789"
