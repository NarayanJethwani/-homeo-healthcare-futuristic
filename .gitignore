# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch directory containing debug scripts and datasets
/scratch/
/scratch

# docs pending update config
/docs/pending-update.json

# Ignore large generated corpus files
data/**/corpus.json
data/**/rag-documents.json

# firestore debug logs
firestore-debug.log
firebase-debug.log


